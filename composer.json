{
    "name": "gopgio/volunteer-platform",
    "description": "Góp Gió Volunteer - Nền tảng kết nối tình nguyện viên và quản lý hoạt động thiện nguyện, hiến máu nhân đạo (PHP 8.2+ MVC OOP PDO MySQL)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-mbstring": "*",
        "ext-json": "*",
        "ext-gd": "*",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "scripts": {
        "test": "php tests/run_tests.php",
        "serve": "php -S localhost:8080 -t public"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
