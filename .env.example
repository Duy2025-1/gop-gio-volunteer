# =========================================================
# GÓP GIÓ VOLUNTEER - ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================

APP_NAME="Góp Gió Volunteer"
APP_SLOGAN="Một hành động nhỏ – Ngàn giá trị lớn."
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Database Configuration (MySQL 8.0)
# For Docker Compose, use DB_HOST=db. For local development, use DB_HOST=127.0.0.1
# Set DB_FALLBACK_SQLITE=true to allow local demo/test execution if MySQL is offline
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gop_gio_volunteer
DB_USERNAME=gopgio_user
DB_PASSWORD=gopgio_secret_2026
DB_ROOT_PASSWORD=root_secret_2026
DB_CHARSET=utf8mb4
DB_FALLBACK_SQLITE=true

# Security & Session
SESSION_NAME=GOPGIO_SESSID
SESSION_LIFETIME=7200
CSRF_TOKEN_SECRET=change_this_to_a_random_64_char_secret_in_production_2026
QR_HMAC_SECRET=gopgio_qr_hmac_signing_key_2026_secure
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Upload Settings
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_MIMES=image/jpeg,image/png,image/webp

# Docker Ports
WEB_PORT=8080
PMA_PORT=8081
MYSQL_EXTERNAL_PORT=33060
